{
  "name": "mastodon-openapi",
  "version": "1.0.0",
  "private": true,
  "description": "Mastodon OpenAPI package",
  "engines": {
    "node": "26"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "redocly preview -d dist",
    "generate": "ts-node src/index.ts",
    "validate": "redocly lint --format=github-actions dist/schema.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "ts-node scripts/setup-docs.ts",
    "setup-security-policy": "ts-node scripts/setup-security-policy.ts",
    "update-docs": "ts-node scripts/update-docs.ts"
  },
  "keywords": [
    "mastodon",
    "openapi",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@redocly/cli": "^2.83.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "3.10.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  }
}
